# Copy this file to .env.local and add your own key.
#   cp .env.example .env.local

# Google AI Studio API key — powers the AI news summaries (English + Hindi).
# Get a free key at: https://aistudio.google.com/apikey
# Optional: the app still runs without it and falls back to basic summaries.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
